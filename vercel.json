{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "smartpark-api": {
      "root": "backend",
      "framework": "express",
      "buildCommand": "npm ci && npx prisma generate && npm run build"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "smartpark-api" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
